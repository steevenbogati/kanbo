# Copia este archivo como .env.local y pega tus valores reales.
# .env.local NUNCA se sube a GitHub.

# Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Supabase → Project Settings → API Keys → publishable key (antes "anon")
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Supabase → Project Settings → API Keys → secret key (antes "service_role")
# Solo se usa en el servidor, para crear usuarios y enviar notificaciones.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Envío de correos. Si lo dejas vacío, la app no envía nada: escribe en la terminal
# el correo que habría enviado, para que puedas revisarlo.
RESEND_API_KEY=
EMAIL_FROM="Kanbo <tareas@tudominio.com>"

# Dirección de la app, para los enlaces dentro de los correos.
# En local es el puerto que uses; en producción, la dirección de Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clave secreta que protege el endpoint de recordatorios diarios.
CRON_SECRET=
